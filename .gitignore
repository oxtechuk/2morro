# ==========================================
# Laravel & PHP Dependencies
# ==========================================
/vendor/
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Environment & Sensitive Files
# ==========================================
.env
.env.backup
.env.production
.env.*.local
!.env.example
auth.json
oauth-public.key
oauth-private.key

# ==========================================
# Laravel Storage, Cache & Logs
# ==========================================
/bootstrap/cache/*
!/bootstrap/cache/.gitignore
/storage/*.key
/storage/app/*
!/storage/app/.gitignore
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore

# ==========================================
# Frontend Build, Vite & Hot Reload
# ==========================================
.vite/
/public/hot
/public/storage

# ==========================================
# Testing & Coverage
# ==========================================
.phpunit.result.cache
.phpunit.cache/
coverage/
*.phpunit.cache

# ==========================================
# Database Dumps & Scratch Scripts
# ==========================================
*.sql
*.sqlite
*.sqlite-journal
check_settings.php
scratch_*.php
setup_assets.php

# ==========================================
# Flutter / Dart (Mobile Apps)
# ==========================================
**/Flutter/**/.dart_tool/
**/Flutter/**/.flutter-plugins
**/Flutter/**/.flutter-plugins-dependencies
**/Flutter/**/.packages
**/Flutter/**/.pub-cache/
**/Flutter/**/.pub/
**/Flutter/**/build/
**/Flutter/**/ephemeral/
**/Flutter/**/android/.gradle/
**/Flutter/**/android/local.properties
**/Flutter/**/android/app/release/
**/Flutter/**/android/app/debug/
**/Flutter/**/android/app/profile/
**/Flutter/**/ios/.symlinks/
**/Flutter/**/ios/Pods/
**/Flutter/**/ios/Podfile.lock
**/Flutter/**/ios/Flutter/Generated.xcconfig
**/Flutter/**/ios/Flutter/app.framework

# ==========================================
# Large Archives, Updates & Backups
# ==========================================
*.zip
*.tar
*.tar.gz
*.rar
*.7z
/update/
/update.zip

# ==========================================
# IDE & Code Editors
# ==========================================
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.fleet/

